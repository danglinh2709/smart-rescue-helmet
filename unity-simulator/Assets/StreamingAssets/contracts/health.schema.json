{
  "$defs": {
    "ConnectionStatus": {
      "enum": [
        "CONNECTED",
        "DISCONNECTED"
      ],
      "title": "ConnectionStatus",
      "type": "string"
    },
    "DataSource": {
      "enum": [
        "SIMULATOR",
        "HARDWARE"
      ],
      "title": "DataSource",
      "type": "string"
    },
    "SensorHealth": {
      "additionalProperties": false,
      "properties": {
        "co": {
          "$ref": "#/$defs/SensorStatus"
        },
        "imu": {
          "$ref": "#/$defs/SensorStatus"
        },
        "temperature": {
          "$ref": "#/$defs/SensorStatus"
        }
      },
      "required": [
        "temperature",
        "co",
        "imu"
      ],
      "title": "SensorHealth",
      "type": "object"
    },
    "SensorStatus": {
      "enum": [
        "OK",
        "ERROR",
        "UNAVAILABLE"
      ],
      "title": "SensorStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "battery": {
      "maximum": 100,
      "minimum": 0,
      "title": "Battery",
      "type": "number"
    },
    "device_id": {
      "maxLength": 32,
      "minLength": 3,
      "pattern": "^[A-Z][A-Z0-9_-]{2,31}$",
      "title": "Device Id",
      "type": "string"
    },
    "mqtt": {
      "$ref": "#/$defs/ConnectionStatus"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sensors": {
      "$ref": "#/$defs/SensorHealth"
    },
    "source": {
      "$ref": "#/$defs/DataSource"
    },
    "timestamp": {
      "format": "date-time",
      "pattern": "(?:Z|[+-]\\d{2}:\\d{2})$",
      "title": "Timestamp",
      "type": "string"
    },
    "uptime_seconds": {
      "minimum": 0,
      "title": "Uptime Seconds",
      "type": "integer"
    },
    "wifi": {
      "$ref": "#/$defs/ConnectionStatus"
    }
  },
  "required": [
    "schema_version",
    "device_id",
    "timestamp",
    "source",
    "battery",
    "uptime_seconds",
    "wifi",
    "mqtt",
    "sensors"
  ],
  "title": "DeviceHealthMessage",
  "type": "object"
}
