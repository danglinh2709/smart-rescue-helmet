POSTGRES_DB=smart_rescue
POSTGRES_USER=smart_rescue
POSTGRES_PASSWORD=smart_rescue_dev

DATABASE_URL=postgresql+psycopg://smart_rescue:smart_rescue_dev@postgres:5432/smart_rescue

MQTT_HOST=mosquitto
MQTT_PORT=1883

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

SIMULATOR_DEVICE_ID=FF01
SIMULATOR_TELEMETRY_INTERVAL=1
SIMULATOR_STATUS_INTERVAL=2
SIMULATOR_HEALTH_INTERVAL=5
SIMULATOR_MQTT_PUBLISH_ENABLED=true

DEVICE_OFFLINE_TIMEOUT_SECONDS=10
DEVICE_OFFLINE_CHECK_INTERVAL_SECONDS=2
